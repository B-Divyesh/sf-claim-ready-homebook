{
  "name": "claim-ready-homebook",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs && node scripts/verify-deployment.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:claims": "playwright test tests/claims.spec.ts --project=chromium",
    "assets": "node scripts/assets.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "sharp": "0.34.3",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
